# Test suite for stdlib backward compatibility layer (std/cli equivalent)
import "std/test"
import "../src/lib.alya" as cli

function main()
    test_suite("CLI Stdlib Backward Compatibility Tests")
    let r = runner_new()

    # 1. Setting up legacy parser
    let p = cli::cli_parser("compat-app", "A legacy CLI compatibility test")
    cli::cli_set_version(p, "2.0.0")
    runner_assert_str_eq(r, p.version, "2.0.0", "parser version is 2.0.0")

    cli::cli_add_flag(p, "-v, --verbose", "Verbose mode")
    cli::cli_add_flag(p, "-d, --debug", "Debug mode")
    cli::cli_add_option(p, "-o, --output", "default/out", "Output directory")
    cli::cli_add_required_option(p, "-c, --config", "Config path")
    cli::cli_add_command(p, "run", "Execute runner")
    cli::cli_add_argument(p, "file", "Input source file")

    # 2. Parsing valid args
    let sim_args = ["run", "-v", "--output=custom/target", "-c", "app.json", "main.alya"]
    let res = cli::cli_parse(p, sim_args)

    runner_assert_eq(r, cli::cli_has_command(res, "run"), 1, "cli_has_command run is 1")
    runner_assert_str_eq(r, cli::cli_get_command(res), "run", "cli_get_command returns run")
    runner_assert_eq(r, cli::cli_get_flag(res, "verbose"), 1, "cli_get_flag verbose is 1")
    runner_assert_eq(r, cli::cli_get_flag(res, "v"), 1, "cli_get_flag v is 1")
    runner_assert_eq(r, cli::cli_get_flag(res, "debug"), 0, "cli_get_flag debug is 0")
    runner_assert_str_eq(r, cli::cli_get_option(res, "output", ""), "custom/target", "cli_get_option output")
    runner_assert_str_eq(r, cli::cli_get_option(res, "o", ""), "custom/target", "cli_get_option o")
    runner_assert_str_eq(r, cli::cli_get_option(res, "config", ""), "app.json", "cli_get_option config")
    runner_assert_str_eq(r, cli::cli_get_arg(res, 0, ""), "main.alya", "cli_get_arg index 0")
    runner_assert_eq(r, len(cli::cli_get_args(res)), 1, "cli_get_args count is 1")
    runner_assert_eq(r, cli::cli_has_errors(res), 0, "cli_has_errors is 0")
    runner_assert_eq(r, cli::cli_help_requested(res), 0, "cli_help_requested is 0")

    # 3. Parsing with missing required option
    let bad_args = ["run", "-v"]
    let bad_res = cli::cli_parse(p, bad_args)
    runner_assert_eq(r, cli::cli_has_errors(bad_res), 1, "bad_res has errors")
    let errs = cli::cli_get_errors(bad_res)
    runner_assert_eq(r, len(errs) > 0, 1, "bad_res error list is not empty")

    # 4. Automated help screen generation
    let h_screen = cli::cli_help(p)
    runner_assert_eq(r, contains(h_screen, "Usage: compat-app [COMMAND] [OPTIONS]"), 1, "compat help usage")
    runner_assert_eq(r, contains(h_screen, "Commands:"), 1, "compat help commands")
    runner_assert_eq(r, contains(h_screen, "Options:"), 1, "compat help options")
    runner_assert_eq(r, contains(h_screen, "-v, --verbose"), 1, "compat help flag")
    runner_assert_eq(r, contains(h_screen, "-o, --output <value>"), 1, "compat help option")

    # 5. Direct convenience functions
    let raw = cli::cli_raw_args()
    runner_assert_eq(r, len(raw) >= 0, 1, "cli_raw_args returns array")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
