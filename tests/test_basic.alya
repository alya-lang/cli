## Test suite for the cli package: application setup, flags, options, and positional binding
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
@cfg(feature = "env")
import "std/os"
import "../src/lib.alya" as cli

# Verifies the environment fallback of an option.
#
# The positive path needs the variable in the process environment; run the
# suite with `ALYA_CLI_TEST_ENV=value alya test` to cover it. The command
# line always wins over the environment.
@cfg(feature = "env")
function assert_env_fallback(r)
    let app = cli::new_app("env-app", "Environment fallback demo", "1.0.0")
    app.env_option("--token", "ALYA_CLI_TEST_ENV", "fallback", "Access token")

    let ctx = app.parse([])
    if has_env("ALYA_CLI_TEST_ENV") == true
        runner_assert_str_eq(r, ctx.get_option("token"), env("ALYA_CLI_TEST_ENV"), "the environment variable provides the option value")
    else
        runner_assert_str_eq(r, ctx.get_option("token"), "fallback", "the default is kept when the environment variable is unset")
    end
    runner_assert_eq(r, ctx.has("token"), false, "an environment provided value does not count as provided on the command line")

    let ctx2 = app.parse(["--token=explicit"])
    runner_assert_str_eq(r, ctx2.get_option("token"), "explicit", "the command line value wins over the environment")
    runner_assert_eq(r, ctx2.has("token"), true, "a command line value counts as provided")
end

@cfg(not(feature = "env"))
function assert_env_fallback(r)
end

function main()
    test_suite("CLI Core Tests")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Application construction
    # ═══════════════════════════════════════════════════════════
    let app = cli::new_app("test-cli", "A modern test CLI", "1.5.0")
    runner_assert_str_eq(r, app.name, "test-cli", "application name is test-cli")
    runner_assert_str_eq(r, app.version, "1.5.0", "application version is 1.5.0")
    runner_assert_str_eq(r, app.description, "A modern test CLI", "application description is kept")
    runner_assert_eq(r, len(app.options), 0, "a fresh application declares no options")

    # ═══════════════════════════════════════════════════════════
    # 2. Fluent registration
    # ═══════════════════════════════════════════════════════════
    app.flag("-v, --verbose", "Enable verbose mode")
    app.option("-o, --output", "dist", "Output directory")
    app.argument("input", "Input file")
    runner_assert_eq(r, len(app.options), 2, "two options were registered")

    # ═══════════════════════════════════════════════════════════
    # 3. Long options, inline values, and positional binding
    # ═══════════════════════════════════════════════════════════
    let ctx = app.parse(["--verbose", "--output=build", "main.alya"])
    runner_assert_eq(r, ctx.get_flag("verbose"), true, "long flag is enabled")
    runner_assert_eq(r, ctx.get_flag("v"), true, "short alias of the flag is enabled")
    runner_assert_eq(r, ctx.get_flag("quiet"), false, "undeclared flag is disabled")
    runner_assert_str_eq(r, ctx.get_option("output"), "build", "inline option value is parsed")
    runner_assert_str_eq(r, ctx.get_option("o"), "build", "short alias of the option is parsed")
    runner_assert_str_eq(r, ctx.get_arg_named("input"), "main.alya", "named argument is bound")
    runner_assert_str_eq(r, ctx.get_arg(0), "main.alya", "positional value is bound by index")
    runner_assert_eq(r, len(ctx.get_args()), 1, "one positional value was collected")
    runner_assert_eq(r, ctx.has_errors(), false, "valid input produces no diagnostics")
    runner_assert_eq(r, ctx.has("verbose"), true, "ctx.has reports the provided flag")
    runner_assert_eq(r, ctx.has("output"), true, "ctx.has reports the provided option")

    # ═══════════════════════════════════════════════════════════
    # 4. Short options with separated values
    # ═══════════════════════════════════════════════════════════
    let ctx2 = app.parse(["-v", "-o", "bin/out", "server.alya"])
    runner_assert_eq(r, ctx2.get_flag("verbose"), true, "short flag -v enables verbose")
    runner_assert_str_eq(r, ctx2.get_option("output"), "bin/out", "short option -o sets the value")
    runner_assert_str_eq(r, ctx2.get_arg_named("input"), "server.alya", "positional binding still applies")

    # ═══════════════════════════════════════════════════════════
    # 5. Defaults are applied for omitted options
    # ═══════════════════════════════════════════════════════════
    let ctx3 = app.parse([])
    runner_assert_str_eq(r, ctx3.get_option("output"), "dist", "omitted option falls back to its default")
    runner_assert_eq(r, ctx3.get_flag("verbose"), false, "omitted flag stays disabled")
    runner_assert_eq(r, ctx3.has("output"), false, "ctx.has ignores options left at their default")

    # ═══════════════════════════════════════════════════════════
    # 6. The `--` terminator stops option parsing
    # ═══════════════════════════════════════════════════════════
    let ctx4 = app.parse(["-v", "--", "--not-a-flag", "-o", "file.txt"])
    runner_assert_eq(r, ctx4.get_flag("verbose"), true, "flag before -- is parsed")
    runner_assert_eq(r, len(ctx4.get_args()), 3, "values after -- are kept as positionals")
    runner_assert_str_eq(r, ctx4.get_arg(0), "--not-a-flag", "first raw value is preserved")
    runner_assert_str_eq(r, ctx4.get_arg(1), "-o", "second raw value is preserved")
    runner_assert_str_eq(r, ctx4.get_arg(2), "file.txt", "third raw value is preserved")

    # ═══════════════════════════════════════════════════════════
    # 7. Optional arguments with defaults and variadic arguments
    # ═══════════════════════════════════════════════════════════
    let app2 = cli::new_app("multi-arg", "Argument binding demo", "1.0.0")
    app2.argument("mode", "Processing mode", false, "fast")
    app2.variadic_argument("inputs", "Input files")
    let ctx5 = app2.parse(["a.txt", "b.txt"])
    runner_assert_str_eq(r, ctx5.get_arg_named("mode"), "a.txt", "the first positional fills the first argument")
    runner_assert_eq(r, len(ctx5.get_args()), 2, "both positionals were collected")
    runner_assert_eq(r, ctx5.has_errors(), false, "variadic argument accepts the remaining values")

    let ctx6 = app2.parse([])
    runner_assert_str_eq(r, ctx6.get_arg_named("mode"), "fast", "the argument default is applied")
    runner_assert_eq(r, ctx6.has_errors(), false, "an omitted optional argument is not an error")

    # ═══════════════════════════════════════════════════════════
    # 8. Typed accessors
    # ═══════════════════════════════════════════════════════════
    let app3 = cli::new_app("typed", "Typed accessor demo", "1.0.0")
    app3.option("--port", "8080", "Service port")
    app3.option("--dry-run", "false", "Dry run switch")
    let ctx7 = app3.parse(["--port=9090", "--dry-run=yes"])
    runner_assert_eq(r, ctx7.get_int("port", 0), 9090, "numeric option converts to an integer")
    runner_assert_eq(r, ctx7.get_int("port", 1), 9090, "numeric option ignores the fallback")
    runner_assert_eq(r, ctx7.get_bool("dry-run"), true, "textual option converts to a boolean")
    let ctx8 = app3.parse(["--port=not-a-number"])
    runner_assert_eq(r, ctx8.get_int("port", 42), 42, "a non-numeric option falls back to the default")

    # ═══════════════════════════════════════════════════════════
    # 9. Functional registration API
    # ═══════════════════════════════════════════════════════════
    let app4 = cli::new_app("functional", "Functional API demo", "1.0.0")
    cli::add_flag(app4, "-d, --debug", "Debug mode")
    cli::add_option(app4, "-c, --config", "app.toml", "Configuration file")
    cli::add_required_option(app4, "--token", "Access token")
    cli::add_choice_option(app4, "--format", "json", ["json", "yaml"], "Output format")
    cli::add_multi_option(app4, "-I, --include", "Include directories")
    runner_assert_eq(r, len(app4.options), 5, "five options were registered functionally")
    let ctx9 = app4.parse(["--token=abc", "--format=yaml"])
    runner_assert_str_eq(r, ctx9.get_option("config"), "app.toml", "functional registration keeps the default")
    runner_assert_str_eq(r, ctx9.get_option("format"), "yaml", "functional registration parses the choice")
    runner_assert_eq(r, ctx9.has_errors(), false, "the required option was supplied")

    # ═══════════════════════════════════════════════════════════
    # 10. Metadata mutators
    # ═══════════════════════════════════════════════════════════
    let app5 = cli::new_app("meta", "Metadata demo", "1.0.0")
    app5.set_author("Alya Language Contributors")
    app5.set_version("2.0.0")
    runner_assert_str_eq(r, app5.author, "Alya Language Contributors", "the author is stored")
    runner_assert_str_eq(r, app5.version, "2.0.0", "the version is updated")

    # ═══════════════════════════════════════════════════════════
    # 10. Environment-backed options
    # ═══════════════════════════════════════════════════════════
    assert_env_fallback(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
