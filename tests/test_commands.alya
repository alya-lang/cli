## Test suite for subcommands, command aliases, and command-specific options
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as cli

function main()
    test_suite("CLI Subcommands & Routing Tests")
    let r = runner_new()

    let app = cli::new("git-tool", "A modern VCS tool", "3.0.0")
    cli::app_add_flag(app, "-v, --verbose", "Global verbose flag")

    # Command 1: build (alias: b)
    let build_cmd = cli::command("build", "Compile target project", ["b"])
    cli::cmd_add_flag(build_cmd, "-r, --release", "Build in release mode")
    cli::cmd_add_option(build_cmd, "-t, --target", "x64", "Target architecture")
    cli::cmd_add_argument(build_cmd, "source", "Main source entry")
    cli::app_add_command(app, build_cmd)

    # Command 2: test (alias: t)
    let test_cmd = cli::command("test", "Run test suite", ["t"])
    cli::cmd_add_flag(test_cmd, "--watch", "Watch file changes")
    cli::app_add_command(app, test_cmd)

    # Command 3: remote with nested subcommand: add
    let remote_cmd = cli::command("remote", "Manage remotes")
    let remote_add = cli::command("add", "Add a new remote")
    cli::cmd_add_argument(remote_add, "name", "Remote name")
    cli::cmd_add_argument(remote_add, "url", "Remote URL")
    cli::cmd_add_subcommand(remote_cmd, remote_add)
    cli::app_add_command(app, remote_cmd)

    # 1. Matching command by primary name
    let ctx1 = cli::parse(app, ["build", "-r", "--target=arm64", "app.alya"])
    runner_assert_str_eq(r, cli::ctx_get_command(ctx1), "build", "matched build command")
    runner_assert_eq(r, cli::ctx_has_command(ctx1, "build"), 1, "ctx_has_command build is 1")
    runner_assert_eq(r, cli::ctx_get_flag(ctx1, "release"), 1, "command flag release is 1")
    runner_assert_str_eq(r, cli::ctx_get_option(ctx1, "target"), "arm64", "command option target is arm64")
    runner_assert_str_eq(r, cli::ctx_get_arg_named(ctx1, "source"), "app.alya", "command arg source is app.alya")

    # 2. Matching command by alias: 'b' instead of 'build'
    let ctx2 = cli::parse(app, ["b", "-t", "wasm", "web.alya"])
    runner_assert_str_eq(r, cli::ctx_get_command(ctx2), "build", "alias b maps to command build")
    runner_assert_str_eq(r, cli::ctx_get_option(ctx2, "target"), "wasm", "target via alias is wasm")
    runner_assert_str_eq(r, cli::ctx_get_arg_named(ctx2, "source"), "web.alya", "source via alias is web.alya")

    # 3. Global flags combined with subcommands
    let ctx3 = cli::parse(app, ["--verbose", "test", "--watch"])
    runner_assert_eq(r, cli::ctx_get_flag(ctx3, "verbose"), 1, "global verbose flag parsed before command")
    runner_assert_str_eq(r, cli::ctx_get_command(ctx3), "test", "matched test command")
    runner_assert_eq(r, cli::ctx_get_flag(ctx3, "watch"), 1, "test specific flag watch is 1")

    # 4. Nested subcommands: remote add origin https://...
    let ctx4 = cli::parse(app, ["remote", "add", "origin", "https://github.com/alya-lang/cli.git"])
    runner_assert_str_eq(r, cli::ctx_get_command(ctx4), "remote add", "nested command remote add matched")
    runner_assert_eq(r, len(cli::ctx_get_args(ctx4)), 2, "2 positional arguments for remote add")
    runner_assert_str_eq(r, cli::ctx_get_arg_named(ctx4, "name"), "origin", "remote name is origin")
    runner_assert_str_eq(r, cli::ctx_get_arg_named(ctx4, "url"), "https://github.com/alya-lang/cli.git", "remote url matches")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
