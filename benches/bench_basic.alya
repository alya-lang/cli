## Benchmark suite for the cli package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as cli

function main()
    let runner = bench_runner("Alya CLI Micro-Benchmarks")

    # 1. App initialization and option definition
    bench_start(runner, 2000)
    let i = 0
    while i < 2000
        let app = cli::new("bench-cli", "Benchmark CLI tool", "1.0.0")
        cli::app_add_flag(app, "-v, --verbose", "Enable verbose output")
        cli::app_add_flag(app, "-d, --debug", "Enable debug output")
        cli::app_add_option(app, "-o, --output", "dist", "Output target directory")
        cli::app_add_option(app, "-f, --format", "json", "Serialization format")
        let cmd = cli::command("build", "Build project artifacts")
        cli::cmd_add_flag(cmd, "-r, --release", "Build in release mode")
        cli::app_add_command(app, cmd)
        i += 1
    end
    bench_stop(runner, "cli::new + flags/options/commands (2k runs)")

    # 2. Argument parsing
    let app = cli::new("bench-cli", "Benchmark CLI tool", "1.0.0")
    cli::app_add_flag(app, "-v, --verbose", "Enable verbose output")
    cli::app_add_flag(app, "-d, --debug", "Enable debug output")
    cli::app_add_option(app, "-o, --output", "dist", "Output target directory")
    cli::app_add_option(app, "-f, --format", "json", "Serialization format")
    let cmd = cli::command("build", "Build project artifacts")
    cli::cmd_add_flag(cmd, "-r, --release", "Build in release mode")
    cli::app_add_command(app, cmd)

    let test_args = ["build", "-v", "--release", "--output=target/bin", "src/main.alya"]

    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        let ctx = cli::parse(app, test_args)
        cli::ctx_get_flag(ctx, "verbose")
        cli::ctx_get_option(ctx, "output", "")
        cli::ctx_get_command(ctx)
        j += 1
    end
    bench_stop(runner, "cli::parse + query lookups (2k runs)")

    # 3. Formatter benchmark
    bench_start(runner, 20)
    let k = 0
    while k < 20
        cli::help(app)
        k += 1
    end
    bench_stop(runner, "cli::help automated screen format (20 runs)")

    bench_summary(runner)
end

main()
