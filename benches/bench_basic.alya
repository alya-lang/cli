## Benchmark suite for the cli package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Measures the three hot paths of the package: building a specification,
## parsing an argument array, and rendering a usage screen.

import "std/test"
import "../src/lib.alya" as cli

function main()
    let runner = bench_runner("Alya CLI Micro-Benchmarks")

    # ═══════════════════════════════════════════════════════════
    # 1. Specification building
    # ═══════════════════════════════════════════════════════════
    bench_start(runner, 2000)
    let i = 0
    while i < 2000
        let app = cli::new_app("bench-cli", "Benchmark CLI tool", "1.0.0")
        app.flag("-v, --verbose", "Enable verbose output")
        app.flag("-d, --debug", "Enable debug output")
        app.option("-o, --output", "dist", "Output target directory")
        app.option("-f, --format", "json", "Serialization format")
        let cmd = cli::new_command("build", "Build project artifacts")
        cmd.flag("-r, --release", "Build in release mode")
        app.command(cmd)
        i += 1
    end
    bench_stop(runner, "specification building (2k runs)")

    # ═══════════════════════════════════════════════════════════
    # 2. Argument parsing
    # ═══════════════════════════════════════════════════════════
    let app = cli::new_app("bench-cli", "Benchmark CLI tool", "1.0.0")
    app.flag("-v, --verbose", "Enable verbose output")
    app.flag("-d, --debug", "Enable debug output")
    app.option("-o, --output", "dist", "Output target directory")
    app.option("-f, --format", "json", "Serialization format")
    let cmd = cli::new_command("build", "Build project artifacts")
    cmd.flag("-r, --release", "Build in release mode")
    app.command(cmd)

    let test_args = ["build", "-v", "--release", "--output=target/bin", "src/main.alya"]

    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        let ctx = cli::parse(app, test_args)
        ctx.get_flag("verbose")
        ctx.get_option("output", "")
        ctx.get_command()
        j += 1
    end
    bench_stop(runner, "argument parsing + lookups (2k runs)")

    # ═══════════════════════════════════════════════════════════
    # 3. Usage screen rendering
    # ═══════════════════════════════════════════════════════════
    @cfg(feature = "help")
    bench_start(runner, 200)
    let k = 0
    while k < 200
        cli::format_help(app)
        k += 1
    end
    bench_stop(runner, "usage screen rendering (200 runs)")

    bench_summary(runner)
end

main()
