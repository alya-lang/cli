## CLI Help and Screen Formatter
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Renders formatted help screens, version information, and error diagnostics.

import "../types.alya"
import "./utils.alya"

## Formats the complete usage and help documentation for an application or command.
##
## Constructs structured sections for Usage syntax, Description, Commands/Subcommands,
## Options, and Positional Arguments.
##
## ### Parameters
## - `app`: The target `CliApp` instance.
## - `cmd`: Optional `CliCommand` instance. If `0` or null, formats application root help.
##
## ### Returns
## The formatted multi-line help string.
##
## ### Examples
## ```alya
## let help_str = cli_format_help(app)
## say help_str
## ```
pub function cli_format_help(app, cmd = 0) -> string
    let is_cmd = (cmd is not null and cmd != 0)
    let out = "Usage: " + str_from_ptr(app.app_name)
    if is_cmd
        out += " " + str_from_ptr(cmd.cmd_name)
    else
        if len(app.app_commands) > 0
            out += " [COMMAND]"
        end
    end
    out += " [OPTIONS]"

    let arg_defs = app.app_arguments
    if is_cmd
        if len(cmd.cmd_arguments) > 0
            arg_defs = cmd.cmd_arguments
        end
    end

    if len(arg_defs) > 0
        for adef in arg_defs
            if adef.arg_variadic == 1
                out += " [" + str_from_ptr(adef.arg_name) + "...]"
            elif adef.arg_required == 1
                out += " <" + str_from_ptr(adef.arg_name) + ">"
            else
                out += " [" + str_from_ptr(adef.arg_name) + "]"
            end
        end
    end
    out += "\n\n"

    let desc = ""
    if is_cmd
        if len(cmd.cmd_desc) > 0
            desc = str_from_ptr(cmd.cmd_desc)
        end
    end

    if len(desc) == 0
        if len(app.app_desc) > 0
            desc = str_from_ptr(app.app_desc)
        end
    end

    if len(desc) > 0
        out += desc + "\n\n"
    end

    # Commands Section
    if not is_cmd
        if len(app.app_commands) > 0
            out += "Commands:\n"
            for c in app.app_commands
                let label = str_from_ptr(c.cmd_name)
                if len(c.cmd_aliases) > 0
                    label += ", " + _cli_join_array(c.cmd_aliases, ", ")
                end
                out += "  " + _cli_pad_right(label, 16) + " " + str_from_ptr(c.cmd_desc) + "\n"
            end
            out += "\n"
        end
    else
        if len(cmd.cmd_subcommands) > 0
            out += "Subcommands:\n"
            for sc in cmd.cmd_subcommands
                let label = str_from_ptr(sc.cmd_name)
                if len(sc.cmd_aliases) > 0
                    label += ", " + _cli_join_array(sc.cmd_aliases, ", ")
                end
                out += "  " + _cli_pad_right(label, 16) + " " + str_from_ptr(sc.cmd_desc) + "\n"
            end
            out += "\n"
        end
    end

    # Options Section
    let opts = app.app_options
    if is_cmd
        let pool = []
        for p1_opt in app.app_options
            pool.push(p1_opt)
        end
        for p2_opt in cmd.cmd_options
            pool.push(p2_opt)
        end
        opts = pool
    end

    out += "Options:\n"
    for opt in opts
        let s = str_from_ptr(opt.opt_short)
        let l = str_from_ptr(opt.opt_long)
        let d = str_from_ptr(opt.opt_desc)
        let def = str_from_ptr(opt.opt_default)
        let label = ""
        if len(s) > 0
            if len(l) > 0
                label = "-" + s + ", --" + l
            else
                label = "-" + s
            end
        elif len(l) > 0
            label = "    --" + l
        else
            label = "-" + s
        end

        if opt.opt_is_flag == 0
            label += " <value>"
        end

        let line = "  " + _cli_pad_right(label, 26) + " " + d
        if opt.opt_is_flag == 0
            if len(def) > 0
                line += " (default: " + def + ")"
            end
        end
        if opt.opt_required == 1
            line += " (required)"
        end
        if len(opt.opt_choices) > 0
            line += " [choices: " + _cli_join_array(opt.opt_choices, ", ") + "]"
        end
        out += line + "\n"
    end
    out += "  -h, --help                 Show help information\n"
    out += "  -V, --version              Show version information\n"

    # Positional Arguments Section
    if len(arg_defs) > 0
        out += "\nArguments:\n"
        for adef in arg_defs
            let alabel = "<" + str_from_ptr(adef.arg_name) + ">"
            let aline = "  " + _cli_pad_right(alabel, 26) + " " + str_from_ptr(adef.arg_desc)
            if adef.arg_required == 1
                aline += " (required)"
            elif len(adef.arg_default) > 0
                aline += " (default: " + str_from_ptr(adef.arg_default) + ")"
            end
            out += aline + "\n"
        end
    end

    return out
end

## Formats the application name and semantic version string.
##
## ### Parameters
## - `app`: The target `CliApp` instance.
##
## ### Returns
## Formatted version string (e.g. `"mytool 1.0.0"`).
pub function cli_format_version(app) -> string
    return str_from_ptr(app.app_name) + " " + str_from_ptr(app.app_version)
end

## Formats an array of parsing and validation error messages into a diagnostics string.
##
## ### Parameters
## - `errors`: Array of error string messages.
##
## ### Returns
## Formatted error diagnostics string.
pub function cli_format_errors(errors) -> string
    let out = ""
    for err in errors
        out += "Error: " + str_from_ptr(err) + "\n"
    end
    return out
end

## Formats help documentation for this application or subcommand.
##
## ### Parameters
## - `self`: The target `CliApp` instance.
## - `cmd`: Optional subcommand instance. Defaults to `0`.
##
## ### Returns
## Formatted multi-line help string.
pub function CliApp.format_help(self, cmd = 0) -> string
    return cli_format_help(self, cmd)
end

## Formats name and version string for this application.
##
## ### Parameters
## - `self`: The target `CliApp` instance.
##
## ### Returns
## Formatted version string.
pub function CliApp.format_version(self) -> string
    return cli_format_version(self)
end
