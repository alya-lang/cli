## cli Usage Screen Formatter
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Renders the banner, usage line, command list, option list, and argument
## list of an application or one of its commands. Only compiled when the
## `help` feature is active (default-on); `src/lib.alya` keeps a fallback
## stub so callers get a clear descriptive error instead of an undefined
## reference.

import "../types.alya"
import "./internal.alya"

# ───────────────────────────────────────────────────────────────
# Private helpers
# ───────────────────────────────────────────────────────────────

# Builds the label of a command (`name` plus its aliases).
function formatter_command_label(command: CliCommand) -> string
    let label = command.name
    if len(command.aliases) > 0
        label += ", " + internal_join(command.aliases, ", ")
    end
    return label
end

# Builds the label of an option (`-s, --long <value>`).
function formatter_option_label(option: CliOption) -> string
    let label = ""
    if len(option.short_name) > 0
        label = "-" + option.short_name
        if len(option.long_name) > 0
            label += ", --" + option.long_name
        end
    else
        label = "    --" + option.long_name
    end
    if option.kind != OptionKind.Flag
        label += " <value>"
    end
    return label
end

# Builds the note of an option (description plus its constraints).
function formatter_option_note(option: CliOption) -> string
    let note = option.description
    if option.kind != OptionKind.Flag
        if len(option.default_value) > 0
            note += " (default: " + option.default_value + ")"
        end
    end
    if option.required == true
        note += " (required)"
    end
    if len(option.choices) > 0
        note += " [choices: " + internal_join(option.choices, ", ") + "]"
    end
    if len(option.env_var) > 0
        note += " [env: " + option.env_var + "]"
    end
    return note
end

# Builds the label of a positional argument (`<name>`).
function formatter_argument_label(argument: CliArgument) -> string
    if argument.variadic == true
        return "<" + argument.name + ">..."
    end
    return "<" + argument.name + ">"
end

# Builds the note of a positional argument.
function formatter_argument_note(argument: CliArgument) -> string
    let note = argument.description
    if argument.required == true
        note += " (required)"
    elif len(argument.default_value) > 0
        note += " (default: " + argument.default_value + ")"
    end
    return note
end

# Builds the usage placeholder of a positional argument.
function formatter_argument_usage(argument: CliArgument) -> string
    if argument.variadic == true
        return " <" + argument.name + ">..."
    end
    if argument.required == true
        return " <" + argument.name + ">"
    end
    return " [" + argument.name + "]"
end

# Renders aligned rows of labels and notes.
function formatter_render_rows(labels: array, notes: array) -> string
    let width = 0
    for label in labels
        if len(str(label)) > width
            width = len(str(label))
        end
    end
    let out = ""
    let index = 0
    while index < len(labels)
        let label = internal_pad_right(str(labels[index]), width)
        let note = str(notes[index])
        if len(note) > 0
            out += "  " + label + "  " + note + "\n"
        else
            out += "  " + label + "\n"
        end
        index += 1
    end
    return out
end

# Renders the usage screen from its resolved parts.
function formatter_render(app: CliApp, heading: string, subtitle: string, commands: array, options: array, arguments: array) -> string
    let out = ""

    # Banner
    let banner = app.name
    if len(app.version) > 0
        banner += " " + app.version
    end
    if len(app.description) > 0
        banner += " - " + app.description
    end
    out += banner + "\n"

    # Subtitle (the command description)
    if len(subtitle) > 0
        out += subtitle + "\n"
    end
    out += "\n"

    # Usage
    out += "Usage:\n  " + heading + "\n"

    # Commands
    if len(commands) > 0
        let labels = []
        let notes = []
        for command in commands
            labels.push(formatter_command_label(command))
            notes.push(command.description)
        end
        out += "\nCommands:\n" + formatter_render_rows(labels, notes)
    end

    # Options
    let labels = []
    let notes = []
    for option in options
        labels.push(formatter_option_label(option))
        notes.push(formatter_option_note(option))
    end
    labels.push("-h, --help")
    notes.push("Show this help and exit")
    labels.push("-V, --version")
    notes.push("Show version information and exit")
    out += "\nOptions:\n" + formatter_render_rows(labels, notes)

    # Arguments
    if len(arguments) > 0
        labels = []
        notes = []
        for argument in arguments
            labels.push(formatter_argument_label(argument))
            notes.push(formatter_argument_note(argument))
        end
        out += "\nArguments:\n" + formatter_render_rows(labels, notes)
    end

    return out
end

# Builds the usage line of the application root.
function formatter_root_usage(app: CliApp) -> string
    let heading = app.name
    if len(app.commands) > 0
        heading += " [COMMAND]"
    end
    heading += " [OPTIONS]"
    for argument in app.arguments
        heading += formatter_argument_usage(argument)
    end
    return heading
end

# Builds the usage line of a command.
function formatter_command_usage(app: CliApp, cmd: CliCommand, arguments: array) -> string
    let heading = app.name + " " + cmd.name + " [OPTIONS]"
    for argument in arguments
        heading += formatter_argument_usage(argument)
    end
    return heading
end

# ───────────────────────────────────────────────────────────────
# Public formatters
# ───────────────────────────────────────────────────────────────

## Formats the usage screen of an application.
##
## The screen contains the banner, the usage line, the command list, the
## option list (including the automatic `-h`/`--help` and `-V`/`--version`
## entries), and the positional argument list. Columns are aligned.
##
## ### Parameters
## - `app`: The application specification.
##
## ### Returns
## The formatted multi-line usage screen.
##
## ### Examples
## ```alya
## say format_help(app)
## ```
pub function format_help(app: CliApp) -> string
    return formatter_render(app, formatter_root_usage(app), "", app.commands, app.options, app.arguments)
end

## Formats the usage screen of a single command.
##
## The screen lists the global options together with the command-scoped
## ones, and the command arguments (falling back to the application
## arguments when the command declares none).
##
## ### Parameters
## - `app`: The application specification.
## - `cmd`: The command to render.
##
## ### Returns
## The formatted multi-line usage screen.
##
## ### Examples
## ```alya
## say format_command_help(app, build)
## ```
pub function format_command_help(app: CliApp, cmd: CliCommand) -> string
    let arguments = cmd.arguments
    if len(arguments) == 0
        arguments = app.arguments
    end
    let options = []
    for option in cmd.options
        options.push(option)
    end
    for option in app.options
        # A command re-declaring a global option shadows it in the parser,
        # so listing both would only confuse the reader.
        let spec: CliOption = option
        if internal_find_option(cmd.options, spec.short_name) < 0 and internal_find_option(cmd.options, spec.long_name) < 0
            options.push(spec)
        end
    end
    return formatter_render(app, formatter_command_usage(app, cmd, arguments), cmd.description, cmd.subcommands, options, arguments)
end

## Formats the version banner of an application.
##
## ### Parameters
## - `app`: The application specification.
##
## ### Returns
## The version string, e.g. `"mytool 1.2.0"`.
pub function format_version(app: CliApp) -> string
    if len(app.version) == 0
        return app.name
    end
    return app.name + " " + app.version
end

## Formats a list of parse diagnostics into a report.
##
## ### Parameters
## - `errors`: The diagnostics collected by the parsing engine.
##
## ### Returns
## One `"Error: ..."` line per diagnostic.
pub function format_errors(errors: array) -> string
    let out = ""
    for error in errors
        out += "Error: " + str(error.message) + "\n"
    end
    return out
end
