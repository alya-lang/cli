pub function CliApp.command(self: CliApp, cmd: CliCommand) -> CliApp
    return app_add_command(self, cmd)
end

## Parses argument strings with this app.
pub function CliApp.parse(self: CliApp, raw_args: array) -> CliContext
    return app_parse(self, raw_args)
end

## Parses given or process arguments with this app.
pub function CliApp.run(self: CliApp, raw_args = null) -> CliContext
    if raw_args is null
        return app_parse_args(self)
    end
    return app_parse(self, raw_args)
end

