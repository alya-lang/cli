pub function cmd_add_argument(cmd, name, description = "", required = 0, default_val = "")
    let arg = CliArgument(name, description, required, default_val, 0)
    let args_list = cmd.cmd_arguments
    args_list.push(arg)
    return cmd
end

pub function cmd_add_variadic_argument(cmd, name, description = "")
    let arg = CliArgument(name, description, 0, "", 1)
    let args_list = cmd.cmd_arguments
    args_list.push(arg)
