# CLI Package - Core Parser Implementation
# Manages options, arguments, commands, subcommands, and parsing lifecycle.

import "../types.alya"
import "./utils.alya"

# --- Public Constructors & Mutators ---

pub function app_new(name, description = "", version = "1.0.0")
    return CliApp(name, description, version, "", [], [], [])
end

pub function app_get_name(app)
    return str_from_ptr(app.app_name)
end

pub function app_get_version(app)
    return str_from_ptr(app.app_version)
end

pub function app_set_author(app, author)
    app.app_author = author
    return app
end

pub function app_set_version(app, version)
    app.app_version = version
    return app
end

pub function app_add_flag(app, flags_spec, description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, "0", 1, 0, 0, [])
    let opts = app.app_options
    opts.push(opt)
    return app
end

pub function app_add_option(app, flags_spec, default_val = "", description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, default_val, 0, 0, 0, [])
    let opts = app.app_options
    opts.push(opt)
    return app
end

pub function app_add_multi_option(app, flags_spec, description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, "", 0, 1, 0, [])
    let opts = app.app_options
    opts.push(opt)
    return app
end

pub function app_add_choice_option(app, flags_spec, default_val, choices, description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, default_val, 0, 0, 0, choices)
    let opts = app.app_options
    opts.push(opt)
    return app
end

pub function app_add_required_option(app, flags_spec, description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, "", 0, 0, 1, [])
    let opts = app.app_options
    opts.push(opt)
    return app
end

pub function app_add_argument(app, name, description = "", required = 0, default_val = "")
    let arg = CliArgument(name, description, required, default_val, 0)
    let args_list = app.app_arguments
    args_list.push(arg)
    return app
end

pub function app_add_variadic_argument(app, name, description = "")
    let arg = CliArgument(name, description, 0, "", 1)
    let args_list = app.app_arguments
    args_list.push(arg)
    return app
end

pub function app_add_command(app, cmd)
    let cmds = app.app_commands
    cmds.push(cmd)
    return app
end

