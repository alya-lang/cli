pub function cmd_add_required_option(cmd, flags_spec, description = "")
    let names = _cli_parse_flags_spec(flags_spec)
    let s = str_from_ptr(names[0])
    let l = str_from_ptr(names[1])
    let opt = CliOption(s, l, description, "", 0, 0, 1, [])
