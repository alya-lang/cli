## cli Parsing Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Turns a raw argument array into a resolved `CliContext`: token
## classification, option binding, subcommand routing, positional binding,
## and validation. Headless by design — no I/O, only data transformation.
##
## The engine is forgiving: diagnostics are collected in `ctx.errors`
## instead of aborting, so a caller decides whether to print them, exit, or
## continue. The strict slice in `src/core/errors.alya` layers the throwing
## and recovering variants on top of this engine.

import "../types.alya"
import "./internal.alya"
@cfg(feature = "env")
import "std/os"

# ───────────────────────────────────────────────────────────────
# Private state
# ───────────────────────────────────────────────────────────────

# Mutable parsing state shared by the scan helpers.
struct ParseScope
    flags: map,
    options: map,
    multi_options: map,
    provided: map,
    errors: array
end

# ───────────────────────────────────────────────────────────────
# Private helpers
# ───────────────────────────────────────────────────────────────

# Classifies an argument token.
function parser_classify(token: string) -> int
    if internal_starts_with(token, "--no-") == true
        return TokenKind.Inverted
    end
    if internal_starts_with(token, "--") == true
        return TokenKind.Long
    end
    if internal_starts_with(token, "-") == true and token != "-"
        return TokenKind.Short
    end
    return TokenKind.Positional
end

# Merges two option lists, keeping the first list in front.
function parser_merge_options(primary: array, secondary: array) -> array
    let merged = []
    for option in primary
        merged.push(option)
    end
    for option in secondary
        merged.push(option)
    end
    return merged
end

# Seeds the default state of the given options into the scope.
#
# Names that were already provided are left untouched: a command that
# re-declares a global option must not reset the value given before the
# command name.
function parser_seed_defaults(options: array, scope: ParseScope)
    for option in options
        let spec: CliOption = option
        if spec.kind == OptionKind.Flag
            if len(spec.short_name) > 0 and spec.short_name not in scope.provided
                scope.flags[spec.short_name] = false
            end
            if len(spec.long_name) > 0 and spec.long_name not in scope.provided
                scope.flags[spec.long_name] = false
            end
        elif spec.kind == OptionKind.Multi
            if len(spec.short_name) > 0 and spec.short_name not in scope.provided
                scope.multi_options[spec.short_name] = []
            end
            if len(spec.long_name) > 0 and spec.long_name not in scope.provided
                scope.multi_options[spec.long_name] = []
            end
        else
            if len(spec.short_name) > 0 and spec.short_name not in scope.provided
                scope.options[spec.short_name] = spec.default_value
            end
            if len(spec.long_name) > 0 and spec.long_name not in scope.provided
                scope.options[spec.long_name] = spec.default_value
            end
        end
    end
end

# Collects every distinct name an option answers to.
function parser_option_names(option: CliOption, used_name: string) -> array
    let names = []
    if len(used_name) > 0
        names.push(used_name)
    end
    let short_name = option.short_name
    let long_name = option.long_name
    if len(short_name) > 0 and short_name not in names
        names.push(short_name)
    end
    if len(long_name) > 0 and long_name not in names
        names.push(long_name)
    end
    return names
end

# Stores the state of a boolean flag under every known name.
function parser_store_flag(option: CliOption, name: string, state: bool, scope: ParseScope)
    for key in parser_option_names(option, name)
        scope.flags[key] = state
        scope.provided[key] = true
    end
end

# Stores the value of a value or repeatable option under every known name.
#
# The short and the long name always share the same bucket, so a value given
# as `-I src` is visible through `--include` as well.
function parser_store_value(option: CliOption, name: string, value: string, scope: ParseScope)
    for key in parser_option_names(option, name)
        if option.kind == OptionKind.Multi
            if key not in scope.multi_options
                scope.multi_options[key] = []
            end
            let bucket = scope.multi_options[key]
            bucket.push(value)
        else
            scope.options[key] = value
        end
        scope.provided[key] = true
    end
end

# Applies a negated flag such as `--no-color`.
function parser_apply_inverted(lookup_options: array, token: string, scope: ParseScope)
    let base = token[5..len(token)]
    let index = internal_find_option(lookup_options, base)
    if index < 0
        scope.errors.push(make_error(ErrorCode.UnknownOption, base, "Unknown option: --no-" + base))
        return
    end
    let option: CliOption = lookup_options[index]
    if option.kind != OptionKind.Flag
        scope.errors.push(make_error(ErrorCode.InvalidUsage, base, "Option --" + base + " does not support the --no- form"))
        return
    end
    scope.flags["no-" + base] = true
    scope.provided["no-" + base] = true
    for key in parser_option_names(option, base)
        scope.flags[key] = false
        scope.provided[key] = true
    end
end

# Applies a long option, returning the index of the next token.
function parser_apply_long(lookup_options: array, token: string, index: int, raw_args: array, scope: ParseScope) -> int
    let token_length = len(token)
    let separator = internal_find_char(token, "=")
    let name = ""
    let value = ""
    let has_value = false
    if separator >= 0
        name = token[2..separator]
        value = token[(separator + 1)..token_length]
        has_value = true
    else
        name = token[2..token_length]
    end

    let option_index = internal_find_option(lookup_options, name)
    if option_index < 0
        scope.errors.push(make_error(ErrorCode.UnknownOption, name, "Unknown option: --" + name))
        scope.flags[name] = true
        return index + 1
    end

    let option: CliOption = lookup_options[option_index]
    if option.kind == OptionKind.Flag
        parser_store_flag(option, name, true, scope)
        return index + 1
    end

    if has_value == false
        if index + 1 >= len(raw_args)
            scope.errors.push(make_error(ErrorCode.MissingValue, name, "Missing value for option: --" + name))
            return index + 1
        end
        index += 1
        value = str(raw_args[index])
    end

    parser_store_value(option, name, value, scope)
    return index + 1
end

# Applies a short option or a cluster of short flags.
function parser_apply_short(lookup_options: array, token: string, index: int, raw_args: array, scope: ParseScope) -> int
    let token_length = len(token)
    let short_name = token[1..2]
    let option_index = internal_find_option(lookup_options, short_name)
    if option_index < 0
        scope.errors.push(make_error(ErrorCode.UnknownOption, short_name, "Unknown option: -" + short_name))
        scope.flags[short_name] = true
        return index + 1
    end

    let option: CliOption = lookup_options[option_index]
    if token_length == 2
        if option.kind == OptionKind.Flag
            parser_store_flag(option, short_name, true, scope)
            return index + 1
        end
        if index + 1 >= len(raw_args)
            scope.errors.push(make_error(ErrorCode.MissingValue, short_name, "Missing value for option: -" + short_name))
            return index + 1
        end
        index += 1
        parser_store_value(option, short_name, str(raw_args[index]), scope)
        return index + 1
    end

    if option.kind == OptionKind.Flag
        # Clustered flags such as `-abc`.
        let position = 1
        while position < token_length
            let letter = token[position..(position + 1)]
            let cluster_index = internal_find_option(lookup_options, letter)
            if cluster_index < 0
                scope.errors.push(make_error(ErrorCode.UnknownOption, letter, "Unknown option: -" + letter))
                scope.flags[letter] = true
            else
                let cluster_option: CliOption = lookup_options[cluster_index]
                if cluster_option.kind != OptionKind.Flag
                    scope.errors.push(make_error(ErrorCode.MissingValue, letter, "Missing value for option: -" + letter))
                    position = token_length
                else
                    parser_store_flag(cluster_option, letter, true, scope)
                end
            end
            position += 1
        end
        return index + 1
    end

    # Attached value such as `-oDist`.
    parser_store_value(option, short_name, token[2..token_length], scope)
    return index + 1
end

# Reads an environment variable, returning an empty string when unavailable.
@cfg(feature = "env")
function parser_env_value(name: string) -> string
    if has_env(name) == false
        return ""
    end
    return env(name)
end

@cfg(not(feature = "env"))
function parser_env_value(name: string) -> string
    return ""
end

# Reports whether an option name was already handled by an earlier entry.
function parser_option_seen(seen: array, option: CliOption) -> bool
    if len(option.long_name) > 0 and option.long_name in seen
        return true
    end
    if len(option.short_name) > 0 and option.short_name in seen
        return true
    end
    return false
end

# Records the names of an option so later duplicates can be skipped.
function parser_mark_seen(seen: array, option: CliOption)
    if len(option.long_name) > 0
        seen.push(option.long_name)
    end
    if len(option.short_name) > 0
        seen.push(option.short_name)
    end
end

# Validates one option and collects the diagnostics it produces.
function parser_validate_option(spec: CliOption, scope: ParseScope)
    let short_name = spec.short_name
    let long_name = spec.long_name
    let display_name = long_name
    if len(display_name) == 0
        display_name = short_name
    end

    let current = ""
    if long_name in scope.options
        current = str(scope.options[long_name])
    elif short_name in scope.options
        current = str(scope.options[short_name])
    end

    # Environment fallback for omitted options.
    if len(current) == 0 and len(spec.env_var) > 0
        let fallback = parser_env_value(spec.env_var)
        if len(fallback) > 0
            current = fallback
            for key in parser_option_names(spec, display_name)
                scope.options[key] = fallback
            end
        end
    end

    if spec.required == true and len(current) == 0
        scope.errors.push(make_error(ErrorCode.MissingRequired, display_name, "Missing required option: --" + display_name))
    end

    if len(spec.choices) > 0 and len(current) > 0
        if current not in spec.choices
            let allowed = internal_join(spec.choices, ", ")
            scope.errors.push(make_error(ErrorCode.InvalidChoice, display_name, "Invalid value '" + current + "' for option --" + display_name + ". Allowed choices: [" + allowed + "]"))
        end
    end
end

# ───────────────────────────────────────────────────────────────
# Parsing engine
# ───────────────────────────────────────────────────────────────

## Parses a raw argument array into a resolved execution context.
##
## Supports long options (`--output dist`, `--output=dist`), short options
## (`-o dist`, `-oDist`), clustered short flags (`-abc`), negated flags
## (`--no-color`), repeatable options (`-I a -I b`), the `--` terminator,
## global options, nested subcommands with aliases, and positional
## arguments (required, optional, and variadic).
##
## ### Parameters
## - `app`: The application specification driving the parse.
## - `raw_args`: The argument array to parse (usually `args()`).
##
## ### Returns
## A `CliContext` with the resolved values and the collected diagnostics.
##
## ### Examples
## ```alya
## let ctx = parse(app, ["--verbose", "input.txt"])
## ```
pub function parse(app: CliApp, raw_args: array) -> CliContext
    let scope = ParseScope {
        flags: {},
        options: {},
        multi_options: {},
        provided: {},
        errors: []
    }

    let global_options = app.options
    let scope_options = app.options
    let lookup_options = app.options
    let scope_arguments = app.arguments
    let scope_commands = app.commands
    let scope_depth = 0

    let command_name = ""
    let command_path = ""
    let help_requested = false
    let version_requested = false
    let orphan_token = ""

    let positional = []
    let named = {}

    parser_seed_defaults(global_options, scope)

    let count = len(raw_args)
    let index = 0
    let stop_options = false

    while index < count
        let token = str(raw_args[index])

        if stop_options == true
            positional.push(token)
            index += 1
        elif token == "--"
            stop_options = true
            index += 1
        elif token == "-h" or token == "--help"
            help_requested = true
            scope.flags["help"] = true
            scope.flags["h"] = true
            index += 1
        elif token == "-V" or token == "--version"
            version_requested = true
            scope.flags["version"] = true
            scope.flags["V"] = true
            index += 1
        else
            let kind = parser_classify(token)
            if kind == TokenKind.Inverted
                parser_apply_inverted(lookup_options, token, scope)
                index += 1
            elif kind == TokenKind.Long
                index = parser_apply_long(lookup_options, token, index, raw_args, scope)
            elif kind == TokenKind.Short
                index = parser_apply_short(lookup_options, token, index, raw_args, scope)
            else
                let command_index = internal_find_command(scope_commands, token)
                if command_index >= 0
                    let command: CliCommand = scope_commands[command_index]
                    scope_options = command.options
                    lookup_options = parser_merge_options(command.options, global_options)
                    scope_arguments = command.arguments
                    scope_commands = command.subcommands
                    scope_depth += 1
                    command_name = command.name
                    if scope_depth == 1
                        command_path = command.name
                    else
                        command_path += " " + command.name
                    end
                    parser_seed_defaults(scope_options, scope)
                    index += 1
                else
                    if scope_depth == 0 and len(app.commands) > 0 and len(app.arguments) == 0
                        if len(orphan_token) == 0
                            orphan_token = token
                        end
                    end
                    positional.push(token)
                    index += 1
                end
            end
        end
    end

    # ── Validation of the effective option set ──
    # A command re-declaring a global option shadows it, so the first
    # definition of a name wins and is validated only once.
    let seen = []
    for option in lookup_options
        let spec: CliOption = option
        if parser_option_seen(seen, spec) == false
            parser_validate_option(spec, scope)
        end
        parser_mark_seen(seen, spec)
    end

    # ── Unknown command detection ──
    if len(orphan_token) > 0 and help_requested == false and version_requested == false
        scope.errors.push(make_error(ErrorCode.UnknownCommand, orphan_token, "Unknown command: " + orphan_token))
    end

    # ── Positional binding ──
    let definitions = scope_arguments
    if scope_depth > 0 and len(scope_arguments) == 0
        definitions = app.arguments
    end

    let definition_count = len(definitions)
    let positional_count = len(positional)
    let definition_index = 0
    let value_index = 0

    while definition_index < definition_count
        let definition: CliArgument = definitions[definition_index]
        let argument_name = definition.name
        if definition.variadic == true
            let remaining = []
            while value_index < positional_count
                remaining.push(positional[value_index])
                value_index += 1
            end
            named[argument_name] = remaining
        else
            if value_index < positional_count
                named[argument_name] = positional[value_index]
                value_index += 1
            else
                if definition.required == true
                    scope.errors.push(make_error(ErrorCode.MissingArgument, argument_name, "Missing required argument: <" + argument_name + ">"))
                elif len(definition.default_value) > 0
                    named[argument_name] = definition.default_value
                end
            end
        end
        definition_index += 1
    end

    return CliContext {
        app: app,
        command_name: command_name,
        command_path: command_path,
        flags: scope.flags,
        options: scope.options,
        multi_options: scope.multi_options,
        provided: scope.provided,
        positional: positional,
        named: named,
        errors: scope.errors,
        help_requested: help_requested,
        version_requested: version_requested,
        raw_args: raw_args
    }
end

## Parses the process arguments into a resolved execution context.
##
## ### Parameters
## - `app`: The application specification driving the parse.
##
## ### Returns
## A `CliContext` with the resolved values and the collected diagnostics.
##
## ### Examples
## ```alya
## let ctx = parse_args(app)
## ```
pub function parse_args(app: CliApp) -> CliContext
    return parse(app, args())
end

# ───────────────────────────────────────────────────────────────
# Context accessors
# ───────────────────────────────────────────────────────────────

## Returns the state of a parsed flag.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Flag name, with or without leading dashes.
##
## ### Returns
## `true` when the flag was enabled, `false` otherwise.
pub function ctx_get_flag(ctx: CliContext, name: string) -> bool
    let clean = internal_strip_dashes(name)
    let flags = ctx.flags
    if clean in flags
        return flags[clean] == true
    end
    return false
end

## Returns the value of a parsed option.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
## - `default_value`: Value returned when the option is absent. Defaults to `""`.
##
## ### Returns
## The resolved option value, or `default_value`.
pub function ctx_get_option(ctx: CliContext, name: string, default_value: string = "") -> string
    let clean = internal_strip_dashes(name)
    let options = ctx.options
    if clean in options
        return str(options[clean])
    end
    return default_value
end

## Returns the value of a parsed option converted to an integer.
##
## Non-numeric values fall back to `default_value`.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
## - `default_value`: Value returned when the option is absent or not numeric. Defaults to `0`.
##
## ### Returns
## The integer value of the option, or `default_value`.
pub function ctx_get_int(ctx: CliContext, name: string, default_value: int = 0) -> int
    return internal_to_int(ctx_get_option(ctx, name, ""), default_value)
end

## Returns the boolean value of a parsed option.
##
## Accepts `1`, `true`, `yes`, and `on` as true; falls back to the flag state.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
##
## ### Returns
## `true` when the value reads as true, `false` otherwise.
pub function ctx_get_bool(ctx: CliContext, name: string) -> bool
    let clean = internal_strip_dashes(name)
    let options = ctx.options
    if clean in options
        return internal_is_truthy(str(options[clean]))
    end
    return ctx_get_flag(ctx, name)
end

## Returns every value collected for a repeatable option.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
##
## ### Returns
## The collected values, or an empty array when the option is absent.
pub function ctx_get_all(ctx: CliContext, name: string) -> array
    let clean = internal_strip_dashes(name)
    let multi_options = ctx.multi_options
    if clean in multi_options
        return multi_options[clean]
    end
    return []
end

## Returns a positional value by position.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `index`: Zero-based position of the value.
## - `default_value`: Value returned when the position is out of range. Defaults to `""`.
##
## ### Returns
## The positional value, or `default_value`.
pub function ctx_get_arg(ctx: CliContext, index: int, default_value: string = "") -> string
    let values = ctx.positional
    if index >= 0 and index < len(values)
        return str(values[index])
    end
    return default_value
end

## Returns a positional value by argument name.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Argument name as declared in the specification.
## - `default_value`: Value returned when the argument is absent. Defaults to `""`.
##
## ### Returns
## The bound value, or `default_value`.
pub function ctx_get_arg_named(ctx: CliContext, name: string, default_value: string = "") -> string
    let named = ctx.named
    if name in named
        return str(named[name])
    end
    return default_value
end

## Returns every positional value in order.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The positional values.
pub function ctx_get_args(ctx: CliContext) -> array
    return ctx.positional
end

## Returns the name of the matched command.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The command name, or an empty string when no command was matched.
pub function ctx_get_command(ctx: CliContext) -> string
    return ctx.command_name
end

## Returns the full path of the matched command.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The space separated command path, e.g. `"remote add"`.
pub function ctx_get_command_path(ctx: CliContext) -> string
    return ctx.command_path
end

## Reports whether the given command was matched.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Command name or alias to look for.
##
## ### Returns
## `true` when the command is active, `false` otherwise.
pub function ctx_has_command(ctx: CliContext, name: string) -> bool
    return ctx.command_name == name
end

## Reports whether the given flag, option, or repeatable option was provided.
##
## Only values that appeared on the command line count: an option left at
## its declared default is reported as absent.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Flag or option name, with or without leading dashes.
##
## ### Returns
## `true` when the value was provided, `false` otherwise.
pub function ctx_has(ctx: CliContext, name: string) -> bool
    let clean = internal_strip_dashes(name)
    let provided = ctx.provided
    if clean in provided
        return true
    end
    return false
end

## Reports whether the parse collected diagnostics.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when at least one diagnostic was collected, `false` otherwise.
pub function ctx_has_errors(ctx: CliContext) -> bool
    return len(ctx.errors) > 0
end

## Returns the collected diagnostics.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The `CliError` instances in the order they were produced.
pub function ctx_get_errors(ctx: CliContext) -> array
    return ctx.errors
end

## Reports whether help was requested.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when `-h` or `--help` was supplied.
pub function ctx_help_requested(ctx: CliContext) -> bool
    return ctx.help_requested == true
end

## Reports whether the version banner was requested.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when `-V` or `--version` was supplied.
pub function ctx_version_requested(ctx: CliContext) -> bool
    return ctx.version_requested == true
end
