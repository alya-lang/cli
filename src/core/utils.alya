## CLI Utility Helpers
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Internal string processing, padding, and flag parsing utilities.

## Checks whether a string begins with the specified prefix.
##
## ### Parameters
## - `s`: The target string to inspect.
## - `prefix`: The prefix substring to search for.
##
## ### Returns
## `1` if `s` starts with `prefix`; `0` otherwise.
pub function _cli_starts_with(s, prefix) -> int
    let s_str = str(s)
    let p_str = str(prefix)
    let slen = len(s_str)
    let plen = len(p_str)
    return when
        slen < plen => 0
        s_str[0..plen] == p_str => 1
        else => 0
    end
end

## Strips leading single (`-`) or double (`--`) dashes from a flag identifier.
##
## ### Parameters
## - `s`: The flag string to clean.
##
## ### Returns
## The identifier string with leading dashes removed.
pub function _cli_strip_dashes(s) -> string
    let s_str = str(s)
    let slen = len(s_str)
    return when
        _cli_starts_with(s_str, "--") == 1 => s_str[2..slen]
        _cli_starts_with(s_str, "-") == 1  => s_str[1..slen]
        else => s_str
    end
end

## Locates the first occurrence of a character within a string.
##
## ### Parameters
## - `s`: The string to search through.
## - `ch`: The single-character string to find.
##
## ### Returns
## The zero-based index of `ch`, or `-1` if not found.
pub function _cli_find_char(s, ch) -> int
    let s_str = str(s)
    let slen = len(s_str)
    let i = 0
    while i < slen
        if char_at(s_str, i) == ch
            return i
        end
        i += 1
    end
    return -1
end

## Pads a string on the right with spaces until it reaches the specified width.
##
## ### Parameters
## - `s`: The original string to pad.
## - `width`: The target minimum string width.
##
## ### Returns
## The padded string.
pub function _cli_pad_right(s, width: int) -> string
    let res = str(s)
    let slen = len(res)
    while slen < width
        res += " "
        slen += 1
    end
    return res
end

## Parses a flag specification string into short and long flag identifiers.
##
## Handles formats such as `"-v, --verbose"`, `"--output, -o"`, `"--help"`, or `"-f"`.
##
## ### Parameters
## - `flags_str`: The comma-delimited flag specification string.
##
## ### Returns
## A 2-element array `[short_name, long_name]`.
pub function _cli_parse_flags_spec(flags_str) -> array
    let s = trim(str(flags_str))
    let short_name = ""
    let long_name = ""
    if contains(s, ",")
        let parts = split(s, ",")
        let p0 = trim(str(parts[0]))
        let p1 = trim(str(parts[1]))
        if _cli_starts_with(p0, "--") == 1
            long_name = p0[2..len(p0)]
        elif _cli_starts_with(p0, "-") == 1
            short_name = p0[1..len(p0)]
        else
            long_name = p0
        end

        if _cli_starts_with(p1, "--") == 1
            long_name = p1[2..len(p1)]
        elif _cli_starts_with(p1, "-") == 1
            short_name = p1[1..len(p1)]
        else
            long_name = p1
        end
    else
        if _cli_starts_with(s, "--") == 1
            long_name = s[2..len(s)]
        elif _cli_starts_with(s, "-") == 1
            short_name = s[1..len(s)]
        else
            long_name = s
        end
    end
    return [short_name, long_name]
end

## Checks whether a target string is present inside an array.
##
## ### Parameters
## - `arr`: The array of candidates to check.
## - `s`: The target string to test.
##
## ### Returns
## `1` if `s` is in `arr`; `0` otherwise.
pub function _cli_str_in_array(arr, s) -> int
    let target = str_from_ptr(s)
    return (target in arr) ? 1 : 0
end

## Concatenates array elements with a delimiter separator string.
##
## ### Parameters
## - `arr`: The array of elements to join.
## - `sep`: The separator string.
##
## ### Returns
## The joined string representation.
pub function _cli_join_array(arr, sep: string) -> string
    let n = len(arr)
    if n == 0
        return ""
    end
    let res = str_from_ptr(arr[0])
    let i = 1
    while i < n
        res += sep + str_from_ptr(arr[i])
        i += 1
    end
    return res
end
