## cli Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines the option, argument, command, and application models, the token
## and error vocabularies, and the parsed execution context that every layer
## of the package shares. The models are plain data: the engines in
## `src/core/` own all behaviour.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Public enumeration of option kinds.
##
## - `Flag`: Boolean switch without a value (`--verbose`).
## - `Value`: Option carrying exactly one value (`--output dist`).
## - `Multi`: Repeatable option collecting an array of values (`-I a -I b`).
pub enum OptionKind
    Flag = 0,
    Value = 1,
    Multi = 2
end

## Public enumeration of command kinds.
##
## - `Root`: The top-level application entry point.
## - `Subcommand`: A command nested under the root application or another command.
pub enum CommandKind
    Root = 0,
    Subcommand = 1
end

## Public enumeration of argument token kinds recognised by the parser.
##
## - `Inverted`: Negated flag (`--no-color`).
## - `Long`: Long option (`--output`).
## - `Short`: Short option (`-o`).
## - `Positional`: Positional value or command name.
pub enum TokenKind
    Inverted = 0,
    Long = 1,
    Short = 2,
    Positional = 3
end

## Public enumeration of structured parse error codes.
##
## - `UnknownOption`: Option the active specification does not declare.
## - `MissingValue`: Value option supplied without a value.
## - `MissingRequired`: Required option omitted.
## - `InvalidChoice`: Value outside the declared choice list.
## - `MissingArgument`: Required positional argument omitted.
## - `UnknownCommand`: Token that matches no declared command.
## - `InvalidUsage`: Option used in a way its kind does not support.
pub enum ErrorCode
    UnknownOption = 0,
    MissingValue = 1,
    MissingRequired = 2,
    InvalidChoice = 3,
    MissingArgument = 4,
    UnknownCommand = 5,
    InvalidUsage = 6
end

# ───────────────────────────────────────────────────────────────
# Data Models
# ───────────────────────────────────────────────────────────────

## Option specification (flag, value option, or repeatable option).
##
## ### Fields
## - `short_name`: Short name without the dash (`"v"`), empty when absent.
## - `long_name`: Long name without dashes (`"verbose"`), empty when absent.
## - `description`: Help text shown in generated usage screens.
## - `default_value`: Value applied when the option is omitted.
## - `kind`: `OptionKind` variant driving the parsing behaviour.
## - `required`: `true` when the option must be provided.
## - `choices`: Allowed values, empty when unrestricted.
## - `env_var`: Environment variable consulted when the option is omitted.
pub struct CliOption
    short_name: string,
    long_name: string,
    description: string,
    default_value: string,
    kind: int,
    required: bool,
    choices: array,
    env_var: string
end

## Positional argument specification.
##
## ### Fields
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in generated usage screens.
## - `required`: `true` when the argument must be provided.
## - `default_value`: Value applied when the argument is omitted.
## - `variadic`: `true` when the argument captures the remaining values.
pub struct CliArgument
    name: string,
    description: string,
    required: bool,
    default_value: string,
    variadic: bool
end

## Command specification.
##
## ### Fields
## - `name`: Primary command name (`"build"`).
## - `aliases`: Alternative names accepted for this command.
## - `description`: Help text shown in generated usage screens.
## - `options`: Command-scoped option specifications.
## - `arguments`: Command-scoped positional argument specifications.
## - `subcommands`: Nested command specifications.
pub struct CliCommand
    name: string,
    aliases: array,
    description: string,
    options: array,
    arguments: array,
    subcommands: array
end

## Application specification.
##
## ### Fields
## - `name`: Executable name shown in usage screens.
## - `description`: One-line summary shown in usage screens.
## - `version`: Version string shown by the version banner.
## - `author`: Author string kept for packaging metadata.
## - `options`: Global option specifications.
## - `arguments`: Global positional argument specifications.
## - `commands`: Registered top-level commands.
pub struct CliApp
    name: string,
    description: string,
    version: string,
    author: string,
    options: array,
    arguments: array,
    commands: array
end

## Parsed execution context produced by the parsing engine.
##
## ### Fields
## - `app`: The application specification that produced this context.
## - `command_name`: Name of the matched command, empty for the root.
## - `command_path`: Space separated path of the matched commands.
## - `flags`: Flag name to boolean state.
## - `options`: Option name to resolved value.
## - `multi_options`: Option name to collected value array.
## - `provided`: Names of the flags and options supplied on the command line.
## - `positional`: Raw positional values in order.
## - `named`: Argument name to bound value.
## - `errors`: Parsing and validation diagnostics.
## - `help_requested`: `true` when `-h` or `--help` was supplied.
## - `version_requested`: `true` when `-V` or `--version` was supplied.
## - `raw_args`: The argument array the context was parsed from.
pub struct CliContext
    app: CliApp,
    command_name: string,
    command_path: string,
    flags: map,
    options: map,
    multi_options: map,
    provided: map,
    positional: array,
    named: map,
    errors: array,
    help_requested: bool,
    version_requested: bool,
    raw_args: array
end

## Structured parse error raised by the strict parsing slice.
##
## ### Fields
## - `code`: `ErrorCode` variant describing the failure category.
## - `subject`: Option, argument, or command the failure refers to.
## - `message`: Human-readable explanation.
pub struct CliError
    code: int,
    subject: string,
    message: string
end

## Outcome of a strict parse, carrying either a context or an error.
##
## ### Fields
## - `ok`: `true` when the parse succeeded.
## - `context`: The parsed context, empty on failure.
## - `error`: Diagnostic message, empty on success.
pub struct CliResult
    ok: bool,
    context: CliContext,
    error: string
end

# ───────────────────────────────────────────────────────────────
# Factories
# ───────────────────────────────────────────────────────────────

## Creates an option specification.
##
## ### Parameters
## - `short_name`: Short name without the dash, empty when absent.
## - `long_name`: Long name without dashes, empty when absent.
## - `description`: Help text shown in usage screens.
## - `default_value`: Value applied when the option is omitted.
## - `kind`: `OptionKind` variant.
## - `required`: `true` when the option must be provided.
## - `choices`: Allowed values, empty when unrestricted.
## - `env_var`: Environment variable consulted when the option is omitted.
##
## ### Returns
## A populated `CliOption` instance.
pub function make_option(short_name: string, long_name: string, description: string, default_value: string, kind: int, required: bool, choices: array, env_var: string) -> CliOption
    return CliOption {
        short_name: short_name,
        long_name: long_name,
        description: description,
        default_value: default_value,
        kind: kind,
        required: required,
        choices: choices,
        env_var: env_var
    }
end

## Creates a positional argument specification.
##
## ### Parameters
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in usage screens.
## - `required`: `true` when the argument must be provided.
## - `default_value`: Value applied when the argument is omitted.
## - `variadic`: `true` when the argument captures the remaining values.
##
## ### Returns
## A populated `CliArgument` instance.
pub function make_argument(name: string, description: string, required: bool, default_value: string, variadic: bool) -> CliArgument
    return CliArgument {
        name: name,
        description: description,
        required: required,
        default_value: default_value,
        variadic: variadic
    }
end

## Creates a command specification.
##
## ### Parameters
## - `name`: Primary command name.
## - `description`: Help text shown in usage screens.
## - `aliases`: Alternative names accepted for this command.
##
## ### Returns
## A populated `CliCommand` instance.
pub function make_command(name: string, description: string, aliases: array) -> CliCommand
    return CliCommand {
        name: name,
        aliases: aliases,
        description: description,
        options: [],
        arguments: [],
        subcommands: []
    }
end

## Creates an application specification.
##
## ### Parameters
## - `name`: Executable name shown in usage screens.
## - `description`: One-line summary shown in usage screens.
## - `version`: Version string shown by the version banner.
##
## ### Returns
## A populated `CliApp` instance.
pub function make_app(name: string, description: string, version: string) -> CliApp
    return CliApp {
        name: name,
        description: description,
        version: version,
        author: "",
        options: [],
        arguments: [],
        commands: []
    }
end

## Creates a structured parse error.
##
## ### Parameters
## - `code`: `ErrorCode` variant describing the failure category.
## - `subject`: Option, argument, or command the failure refers to.
## - `message`: Human-readable explanation.
##
## ### Returns
## A populated `CliError` instance.
##
## ### Examples
## ```alya
## let err = make_error(ErrorCode.MissingValue, "output", "Missing value for option: --output")
## ```
pub function make_error(code: int, subject: string, message: string) -> CliError
    return CliError {
        code: code,
        subject: subject,
        message: message
    }
end

## Formats a structured parse error into a diagnostic string.
##
## ### Parameters
## - `err`: The `CliError` instance to render.
##
## ### Returns
## A diagnostic string such as `"CliError(output): Missing value for option: --output"`.
##
## ### Examples
## ```alya
## say format_error(err)
## ```
pub function format_error(err: CliError) -> string
    return "CliError(" + err.subject + "): " + err.message
end

## Formats a caught error value into a readable diagnostic string.
##
## Dispatches on the error shape with `when`: structured `CliError` values
## render their subject and message, anything else renders generically.
##
## ### Parameters
## - `err`: Value captured by a `catch err` clause.
##
## ### Returns
## A diagnostic string.
##
## ### Examples
## ```alya
## try
##     let ctx = parse_strict(app, args())
## catch err
##     say format_caught_error(err)
## end
## ```
pub function format_caught_error(err) -> string
    return when err
        is CliError => format_error(err)
        else => "error: " + str(err)
    end
end
