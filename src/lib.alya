## Fallback stub for `parse_strict` when the `strict` feature is disabled.
##
## Rebuild with default features (or `--features strict`) for the full
## implementation in `src/core/errors.alya`.
@cfg(not(feature = "strict"))
pub function parse_strict(app: CliApp, raw_args: array) -> CliContext
    throw "strict feature is disabled (rebuild with default features or --features strict)"
end

## Fallback stub for `try_parse` when the `strict` feature is disabled.
##
## Preserves the never-throws contract by returning a failed result carrying
## the descriptive error. Rebuild with default features (or
## `--features strict`) for the full implementation in `src/core/errors.alya`.
@cfg(not(feature = "strict"))
pub function try_parse(app: CliApp, raw_args: array) -> CliResult
    let empty = CliContext {
        app: app,
        command_name: "",
        command_path: "",
        flags: {},
        options: {},
        multi_options: {},
        provided: {},
        positional: [],
        named: {},
        errors: [],
        help_requested: false,
        version_requested: false,
        raw_args: []
    }
    return CliResult {
        ok: false,
        context: empty,
        error: "strict feature is disabled (rebuild with default features or --features strict)"
    }
end
# alya-lint: enable unused-param

