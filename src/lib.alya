## cli Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Public entry point of the `cli` package: application and command
## builders, the parsing entry points, the parsed-context accessors, the
## usage screen renderer, and the structured error helpers.
##
## The facade is a thin layer over the engines in `src/core/`:
## `spec.alya` builds the specifications, `parser.alya` resolves the
## arguments, `formatter.alya` renders the usage screens, and
## `errors.alya` adds the throwing and recovering parse variants.

import "./types.alya"
import "./core/spec.alya" as spec
import "./core/parser.alya" as parser
@cfg(feature = "help")
import "./core/formatter.alya" as formatter
@cfg(feature = "strict")
import "./core/errors.alya" as errors

# ───────────────────────────────────────────────────────────────
# Constructors
# ───────────────────────────────────────────────────────────────

## Creates an application specification.
##
## ### Parameters
## - `name`: Executable name shown in usage screens.
## - `description`: One-line summary shown in usage screens. Defaults to `""`.
## - `version`: Version string shown by the version banner. Defaults to `"1.0.0"`.
##
## ### Returns
## A newly initialized `CliApp` instance.
##
## ### Examples
## ```alya
## let app = new_app("mytool", "A build tool", "1.2.0")
## ```
pub function new_app(name: string, description: string = "", version: string = "1.0.0") -> CliApp
    return spec::app_new(name, description, version)
end

## Creates a command specification.
##
## ### Parameters
## - `name`: Primary command name.
## - `description`: Help text shown in usage screens. Defaults to `""`.
## - `aliases`: Alternative names accepted for this command. Defaults to `[]`.
##
## ### Returns
## A newly initialized `CliCommand` instance.
##
## ### Examples
## ```alya
## let build = new_command("build", "Compile artifacts", ["b"])
## ```
pub function new_command(name: string, description: string = "", aliases: array = []) -> CliCommand
    return spec::cmd_new(name, description, aliases)
end

# ───────────────────────────────────────────────────────────────
# Application builders
# ───────────────────────────────────────────────────────────────

## Registers a boolean flag on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Flag names, e.g. `"-v, --verbose"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_flag(app: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_flag(app, spec, description)
end

## Registers a single-value option on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Option names, e.g. `"-o, --output"`.
## - `default_value`: Value applied when the option is omitted. Defaults to `""`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_option(app: CliApp, spec: string, default_value: string = "", description: string = "") -> CliApp
    return spec::app_add_option(app, spec, default_value, description)
end

## Registers a repeatable option on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Option names, e.g. `"-I, --include"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_multi_option(app: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_multi_option(app, spec, description)
end

## Registers a choice-restricted option on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Option names, e.g. `"--format"`.
## - `default_value`: Value applied when the option is omitted.
## - `choices`: The allowed values.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_choice_option(app: CliApp, spec: string, default_value: string, choices: array, description: string = "") -> CliApp
    return spec::app_add_choice_option(app, spec, default_value, choices, description)
end

## Registers a mandatory option on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Option names, e.g. `"-c, --config"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_required_option(app: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_required_option(app, spec, description)
end

## Registers an option that falls back to an environment variable.
##
## Requires the `env` feature (default-on). The environment variable is
## consulted only when the option is omitted on the command line.
##
## ### Parameters
## - `app`: The application specification.
## - `spec`: Option names, e.g. `"-t, --token"`.
## - `env_var`: Environment variable name, e.g. `"MYTOOL_TOKEN"`.
## - `default_value`: Value applied when neither the option nor the environment provides a value. Defaults to `""`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_env_option(app: CliApp, spec: string, env_var: string, default_value: string = "", description: string = "") -> CliApp
    return spec::app_add_env_option(app, spec, env_var, default_value, description)
end

## Registers a positional argument on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in usage screens. Defaults to `""`.
## - `required`: `true` when the argument must be provided. Defaults to `false`.
## - `default_value`: Value applied when the argument is omitted. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_argument(app: CliApp, name: string, description: string = "", required: bool = false, default_value: string = "") -> CliApp
    return spec::app_add_argument(app, name, description, required, default_value)
end

## Registers a variadic positional argument on an application.
##
## The variadic argument captures every remaining positional value.
##
## ### Parameters
## - `app`: The application specification.
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated application.
pub function add_variadic_argument(app: CliApp, name: string, description: string = "") -> CliApp
    return spec::app_add_variadic_argument(app, name, description)
end

## Registers a command on an application.
##
## ### Parameters
## - `app`: The application specification.
## - `command`: The command specification to register.
##
## ### Returns
## The updated application.
pub function add_command(app: CliApp, command: CliCommand) -> CliApp
    return spec::app_add_command(app, command)
end

## Sets the author string of an application.
##
## ### Parameters
## - `app`: The application specification.
## - `author`: The author string.
##
## ### Returns
## The updated application.
pub function set_author(app: CliApp, author: string) -> CliApp
    return spec::app_set_author(app, author)
end

## Sets the version string of an application.
##
## ### Parameters
## - `app`: The application specification.
## - `version`: The version string.
##
## ### Returns
## The updated application.
pub function set_version(app: CliApp, version: string) -> CliApp
    return spec::app_set_version(app, version)
end

# ───────────────────────────────────────────────────────────────
# Command builders
# ───────────────────────────────────────────────────────────────

## Registers a boolean flag on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Flag names, e.g. `"-r, --release"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_flag(cmd: CliCommand, spec: string, description: string = "") -> CliCommand
    return spec::cmd_add_flag(cmd, spec, description)
end

## Registers a single-value option on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Option names, e.g. `"-t, --target"`.
## - `default_value`: Value applied when the option is omitted. Defaults to `""`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_option(cmd: CliCommand, spec: string, default_value: string = "", description: string = "") -> CliCommand
    return spec::cmd_add_option(cmd, spec, default_value, description)
end

## Registers a repeatable option on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Option names, e.g. `"-I, --include"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_multi_option(cmd: CliCommand, spec: string, description: string = "") -> CliCommand
    return spec::cmd_add_multi_option(cmd, spec, description)
end

## Registers a choice-restricted option on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Option names, e.g. `"-t, --target"`.
## - `default_value`: Value applied when the option is omitted.
## - `choices`: The allowed values.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_choice_option(cmd: CliCommand, spec: string, default_value: string, choices: array, description: string = "") -> CliCommand
    return spec::cmd_add_choice_option(cmd, spec, default_value, choices, description)
end

## Registers a mandatory option on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Option names, e.g. `"-c, --config"`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_required_option(cmd: CliCommand, spec: string, description: string = "") -> CliCommand
    return spec::cmd_add_required_option(cmd, spec, description)
end

## Registers an option that falls back to an environment variable.
##
## Requires the `env` feature (default-on).
##
## ### Parameters
## - `cmd`: The command specification.
## - `spec`: Option names, e.g. `"-t, --token"`.
## - `env_var`: Environment variable name.
## - `default_value`: Value applied when neither the option nor the environment provides a value. Defaults to `""`.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_env_option(cmd: CliCommand, spec: string, env_var: string, default_value: string = "", description: string = "") -> CliCommand
    return spec::cmd_add_env_option(cmd, spec, env_var, default_value, description)
end

## Registers a positional argument on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in usage screens. Defaults to `""`.
## - `required`: `true` when the argument must be provided. Defaults to `false`.
## - `default_value`: Value applied when the argument is omitted. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_argument(cmd: CliCommand, name: string, description: string = "", required: bool = false, default_value: string = "") -> CliCommand
    return spec::cmd_add_argument(cmd, name, description, required, default_value)
end

## Registers a variadic positional argument on a command.
##
## ### Parameters
## - `cmd`: The command specification.
## - `name`: Argument name shown in usage screens.
## - `description`: Help text shown in usage screens. Defaults to `""`.
##
## ### Returns
## The updated command.
pub function command_add_variadic_argument(cmd: CliCommand, name: string, description: string = "") -> CliCommand
    return spec::cmd_add_variadic_argument(cmd, name, description)
end

## Nests a command under another command.
##
## ### Parameters
## - `parent`: The parent command.
## - `child`: The command to nest.
##
## ### Returns
## The updated parent command.
pub function command_add_subcommand(parent: CliCommand, child: CliCommand) -> CliCommand
    return spec::cmd_add_subcommand(parent, child)
end

# ───────────────────────────────────────────────────────────────
# Parsing entry points
# ───────────────────────────────────────────────────────────────

## Parses an argument array into a resolved execution context.
##
## ### Parameters
## - `app`: The application specification driving the parse.
## - `raw_args`: The argument array to parse.
##
## ### Returns
## A `CliContext` with the resolved values and the collected diagnostics.
##
## ### Examples
## ```alya
## let ctx = parse(app, ["--verbose", "input.txt"])
## ```
pub function parse(app: CliApp, raw_args: array) -> CliContext
    return parser::parse(app, raw_args)
end

## Parses the process arguments into a resolved execution context.
##
## ### Parameters
## - `app`: The application specification driving the parse.
##
## ### Returns
## A `CliContext` with the resolved values and the collected diagnostics.
pub function parse_args(app: CliApp) -> CliContext
    return parser::parse_args(app)
end

## Parses an argument array, throwing a structured error on invalid input.
##
## Requires the `strict` feature (default-on).
##
## ### Parameters
## - `app`: The application specification driving the parse.
## - `raw_args`: The argument array to parse.
##
## ### Returns
## A `CliContext` without diagnostics.
##
## ### Examples
## ```alya
## try
##     let ctx = parse_strict(app, args())
## catch err
##     say format_caught_error(err)
## end
## ```
@cfg(feature = "strict")
pub function parse_strict(app: CliApp, raw_args: array) -> CliContext
    return errors::parse_strict(app, raw_args)
end

## Parses an argument array, converting failures into a result container.
##
## Requires the `strict` feature (default-on). Never throws.
##
## ### Parameters
## - `app`: The application specification driving the parse.
## - `raw_args`: The argument array to parse.
##
## ### Returns
## A `CliResult` carrying either the context or the first diagnostic.
@cfg(feature = "strict")
pub function try_parse(app: CliApp, raw_args: array) -> CliResult
    return errors::try_parse(app, raw_args)
end

# ───────────────────────────────────────────────────────────────
# Context accessors
# ───────────────────────────────────────────────────────────────

## Returns the state of a parsed flag.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Flag name, with or without leading dashes.
##
## ### Returns
## `true` when the flag was enabled, `false` otherwise.
pub function get_flag(ctx: CliContext, name: string) -> bool
    return parser::ctx_get_flag(ctx, name)
end

## Returns the value of a parsed option.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
## - `default_value`: Value returned when the option is absent. Defaults to `""`.
##
## ### Returns
## The resolved option value, or `default_value`.
pub function get_option(ctx: CliContext, name: string, default_value: string = "") -> string
    return parser::ctx_get_option(ctx, name, default_value)
end

## Returns the value of a parsed option converted to an integer.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
## - `default_value`: Value returned when the option is absent or not numeric. Defaults to `0`.
##
## ### Returns
## The integer value of the option, or `default_value`.
pub function get_int(ctx: CliContext, name: string, default_value: int = 0) -> int
    return parser::ctx_get_int(ctx, name, default_value)
end

## Returns the boolean value of a parsed option.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
##
## ### Returns
## `true` when the value reads as true, `false` otherwise.
pub function get_bool(ctx: CliContext, name: string) -> bool
    return parser::ctx_get_bool(ctx, name)
end

## Returns every value collected for a repeatable option.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Option name, with or without leading dashes.
##
## ### Returns
## The collected values, or an empty array when the option is absent.
pub function get_all(ctx: CliContext, name: string) -> array
    return parser::ctx_get_all(ctx, name)
end

## Returns a positional value by position.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `index`: Zero-based position of the value.
## - `default_value`: Value returned when the position is out of range. Defaults to `""`.
##
## ### Returns
## The positional value, or `default_value`.
pub function get_arg(ctx: CliContext, index: int, default_value: string = "") -> string
    return parser::ctx_get_arg(ctx, index, default_value)
end

## Returns a positional value by argument name.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Argument name as declared in the specification.
## - `default_value`: Value returned when the argument is absent. Defaults to `""`.
##
## ### Returns
## The bound value, or `default_value`.
pub function get_arg_named(ctx: CliContext, name: string, default_value: string = "") -> string
    return parser::ctx_get_arg_named(ctx, name, default_value)
end

## Returns every positional value in order.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The positional values.
pub function get_args(ctx: CliContext) -> array
    return parser::ctx_get_args(ctx)
end

## Returns the name of the matched command.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The command name, or an empty string when no command was matched.
pub function get_command(ctx: CliContext) -> string
    return parser::ctx_get_command(ctx)
end

## Returns the full path of the matched command.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The space separated command path, e.g. `"remote add"`.
pub function get_command_path(ctx: CliContext) -> string
    return parser::ctx_get_command_path(ctx)
end

## Reports whether the given command was matched.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Command name or alias to look for.
##
## ### Returns
## `true` when the command is active, `false` otherwise.
pub function has_command(ctx: CliContext, name: string) -> bool
    return parser::ctx_has_command(ctx, name)
end

## Reports whether the given flag, option, or repeatable option was provided.
##
## ### Parameters
## - `ctx`: The parsed context.
## - `name`: Flag or option name, with or without leading dashes.
##
## ### Returns
## `true` when the value was provided, `false` otherwise.
pub function has(ctx: CliContext, name: string) -> bool
    return parser::ctx_has(ctx, name)
end

## Reports whether the parse collected diagnostics.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when at least one diagnostic was collected, `false` otherwise.
pub function has_errors(ctx: CliContext) -> bool
    return parser::ctx_has_errors(ctx)
end

## Returns the collected diagnostics.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## The `CliError` instances in the order they were produced.
pub function get_errors(ctx: CliContext) -> array
    return parser::ctx_get_errors(ctx)
end

## Reports whether help was requested.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when `-h` or `--help` was supplied.
pub function help_requested(ctx: CliContext) -> bool
    return parser::ctx_help_requested(ctx)
end

## Reports whether the version banner was requested.
##
## ### Parameters
## - `ctx`: The parsed context.
##
## ### Returns
## `true` when `-V` or `--version` was supplied.
pub function version_requested(ctx: CliContext) -> bool
    return parser::ctx_version_requested(ctx)
end

# ───────────────────────────────────────────────────────────────
# Usage screens
# ───────────────────────────────────────────────────────────────

## Formats the complete usage screen of an application.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
##
## ### Returns
## The formatted multi-line usage screen.
@cfg(feature = "help")
pub function format_help(app: CliApp) -> string
    return formatter::format_help(app)
end

## Formats the complete usage screen of a single command.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
## - `cmd`: The command to render.
##
## ### Returns
## The formatted multi-line usage screen.
@cfg(feature = "help")
pub function format_command_help(app: CliApp, cmd: CliCommand) -> string
    return formatter::format_command_help(app, cmd)
end

## Formats the version banner of an application.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
##
## ### Returns
## The version string, e.g. `"mytool 1.2.0"`.
@cfg(feature = "help")
pub function format_version(app: CliApp) -> string
    return formatter::format_version(app)
end

## Formats a list of parse diagnostics into a report.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `errors`: The diagnostics collected by the parsing engine.
##
## ### Returns
## One `"Error: ..."` line per diagnostic.
@cfg(feature = "help")
pub function format_errors(errors: array) -> string
    return formatter::format_errors(errors)
end

## Prints the usage screen of an application.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
@cfg(feature = "help")
pub function print_help(app: CliApp)
    say formatter::format_help(app)
end

## Prints the usage screen of a single command.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
## - `cmd`: The command to render.
@cfg(feature = "help")
pub function print_command_help(app: CliApp, cmd: CliCommand)
    say formatter::format_command_help(app, cmd)
end

## Prints the version banner of an application.
##
## Requires the `help` feature (default-on).
##
## ### Parameters
## - `app`: The application specification.
@cfg(feature = "help")
pub function print_version(app: CliApp)
    say formatter::format_version(app)
end

# ───────────────────────────────────────────────────────────────
# Feature-gated fallback stubs
# ───────────────────────────────────────────────────────────────

# The stubs below keep the public API surface stable when a feature slice is
# disabled, so callers get a clear descriptive error instead of an
# undefined reference (params unused by design).
# alya-lint: disable unused-param

## Fallback stub for `format_help` when the `help` feature is disabled.
##
## Rebuild with default features (or `--features help`) for the full
## implementation in `src/core/formatter.alya`.
@cfg(not(feature = "help"))
pub function format_help(app: CliApp) -> string
    throw "help feature is disabled (rebuild with default features or --features help)"
end

