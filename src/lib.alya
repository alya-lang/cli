# Struct Methods: CliApp
# ───────────────────────────────────────────────────────────────

## Registers a boolean flag on this application.
pub function CliApp.flag(self: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_flag(self, spec, description)
end

## Registers a single-value option on this application.
pub function CliApp.option(self: CliApp, spec: string, default_value: string = "", description: string = "") -> CliApp
    return spec::app_add_option(self, spec, default_value, description)
end

## Registers a repeatable option on this application.
pub function CliApp.multi_option(self: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_multi_option(self, spec, description)
end

## Registers a choice-restricted option on this application.
pub function CliApp.choice_option(self: CliApp, spec: string, default_value: string, choices: array, description: string = "") -> CliApp
    return spec::app_add_choice_option(self, spec, default_value, choices, description)
end

## Registers a mandatory option on this application.
pub function CliApp.required_option(self: CliApp, spec: string, description: string = "") -> CliApp
    return spec::app_add_required_option(self, spec, description)
end

## Registers an environment-backed option on this application.
pub function CliApp.env_option(self: CliApp, spec: string, env_var: string, default_value: string = "", description: string = "") -> CliApp
    return spec::app_add_env_option(self, spec, env_var, default_value, description)
end

## Registers a positional argument on this application.
pub function CliApp.argument(self: CliApp, name: string, description: string = "", required: bool = false, default_value: string = "") -> CliApp
    return spec::app_add_argument(self, name, description, required, default_value)
end

## Registers a variadic positional argument on this application.
pub function CliApp.variadic_argument(self: CliApp, name: string, description: string = "") -> CliApp
    return spec::app_add_variadic_argument(self, name, description)
end

## Registers a command on this application.
pub function CliApp.command(self: CliApp, command: CliCommand) -> CliApp
    return spec::app_add_command(self, command)
end

## Sets the author string of this application.
pub function CliApp.set_author(self: CliApp, author: string) -> CliApp
    return spec::app_set_author(self, author)
end

## Sets the version string of this application.
pub function CliApp.set_version(self: CliApp, version: string) -> CliApp
    return spec::app_set_version(self, version)
end

## Parses an argument array with this application.
pub function CliApp.parse(self: CliApp, raw_args: array) -> CliContext
    return parser::parse(self, raw_args)
end

## Parses the given arguments, or the process arguments when none are given.
pub function CliApp.run(self: CliApp, raw_args = null) -> CliContext
    if raw_args is null
        return parser::parse_args(self)
    end
    return parser::parse(self, raw_args)
end

