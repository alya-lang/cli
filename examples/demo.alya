## Demo of the cli package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Builds a realistic command line tool, renders its usage screen, and
## parses a simulated invocation.

import "../src/lib.alya" as cli

function main()
    say "=== 1. Building the application ==="
    let app = cli::new_app("forge", "Alya high-performance build and test tool", "1.0.0")
    app.set_author("Alya Language Contributors")

    # Global options
    app.flag("-v, --verbose", "Enable verbose diagnostic logs")
    app.flag("-q, --quiet", "Suppress all non-error output")
    app.option("-c, --config", "forge.toml", "Configuration file path")
    app.env_option("--token", "FORGE_TOKEN", "", "Access token for the registry")

    # The `build` command
    let build = cli::new_command("build", "Compile target source packages", ["b"])
    build.flag("-r, --release", "Build optimized release binaries")
    build.option("-o, --output", "dist", "Output directory")
    build.choice_option("-t, --target", "native", ["native", "x64", "arm64"], "Target architecture")
    build.argument("entrypoint", "Source file to compile", false, "src/main.alya")
    app.command(build)

    # The `test` command
    let test_cmd = cli::new_command("test", "Execute unit and integration tests", ["t"])
    test_cmd.flag("-f, --fail-fast", "Abort on the first test failure")
    test_cmd.variadic_argument("filters", "Only run the matching test filters")
    app.command(test_cmd)

    # The `remote` command with a nested subcommand
    let remote = cli::new_command("remote", "Manage the configured remotes")
    let remote_add = cli::new_command("add", "Add a new remote")
    remote_add.argument("name", "Remote name")
    remote_add.argument("url", "Remote URL")
    remote.subcommand(remote_add)
    app.command(remote)

    say "Application '" + app.name + "' v" + app.version + " is ready."
    say ""

    # ═══════════════════════════════════════════════════════════
    say "=== 2. Generated usage screen ==="
    @cfg(feature = "help")
    say cli::format_help(app)

    # ═══════════════════════════════════════════════════════════
    say "=== 3. Parsing a simulated invocation ==="
    let sample = ["build", "-v", "--release", "--target=native", "-o", "bin/release", "server.alya"]
    say "forge " + "build -v --release --target=native -o bin/release server.alya"
    say ""

    let ctx = app.parse(sample)
    if ctx.has_errors()
        say "Diagnostics:"
        for error in ctx.get_errors()
            say "  * " + error.message
        end
    else
        say "Command        : " + ctx.get_command()
        say "Command path   : " + ctx.get_command_path()
        say "Verbose mode   : " + (ctx.get_flag("verbose") == true ? "yes" : "no")
        say "Release mode   : " + (ctx.get_flag("release") == true ? "yes" : "no")
        say "Target arch    : " + ctx.get_option("target", "native")
        say "Output path    : " + ctx.get_option("output", "dist")
        say "Source file    : " + ctx.get_arg_named("entrypoint", "src/main.alya")
        say "Config file    : " + ctx.get_option("config", "forge.toml")
    end
    say ""

    # ═══════════════════════════════════════════════════════════
    say "=== 4. Diagnostics for an invalid invocation ==="
    let broken = app.parse(["deploy", "--format=xml"])
    say "forge deploy --format=xml"
    for error in broken.get_errors()
        say "  * " + error.message
    end
    say ""

    # ═══════════════════════════════════════════════════════════
    say "=== 5. Nested subcommand routing ==="
    let nested = app.parse(["remote", "add", "origin", "https://github.com/alya-lang/cli.git"])
    say "Command path   : " + nested.get_command_path()
    say "Remote name    : " + nested.get_arg_named("name")
    say "Remote url     : " + nested.get_arg_named("url")
    say ""

    # ═══════════════════════════════════════════════════════════
    say "=== 6. Strict parsing (structured errors) ==="
    @cfg(feature = "strict")
    let outcome = cli::try_parse(app, ["build", "--target=wasm"])
    if outcome.is_error()
        say "Rejected: " + outcome.message()
    else
        say "Accepted: " + outcome.context().get_option("target", "native")
    end
end

main()
