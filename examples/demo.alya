# Example usage of cli package
import "../src/lib.alya" as cli

function main()
    # 1. Initialize application
    let app = cli::new("forge", "Alya high-performance build and test tool", "1.0.0")
    cli::app_set_author(app, "Alya Language Contributors")

    # 2. Configure global flags and options
    cli::app_add_flag(app, "-v, --verbose", "Enable verbose diagnostic logs")
    cli::app_add_flag(app, "-q, --quiet", "Suppress all non-error output")
    cli::app_add_option(app, "-c, --config", "forge.toml", "Configuration file path")

    # 3. Add 'build' command with options and arguments
    let build_cmd = cli::command("build", "Compile target source packages", ["b"])
    cli::cmd_add_flag(build_cmd, "-r, --release", "Build optimized release binaries")
    cli::cmd_add_option(build_cmd, "-o, --output", "dist", "Output directory")
    cli::cmd_add_choice_option(build_cmd, "-t, --target", "native", ["native", "x64", "arm64"], "Target architecture")
    cli::cmd_add_argument(build_cmd, "entrypoint", "Source file to compile", 0, "src/main.alya")
    cli::app_add_command(app, build_cmd)

    # 4. Add 'test' command
    let test_cmd = cli::command("test", "Execute unit and integration tests", ["t"])
    cli::cmd_add_flag(test_cmd, "-f, --fail-fast", "Abort on first test failure")
    cli::app_add_command(app, test_cmd)

    # 5. Display automated help screen
    say "=== Automated Help Screen Demo ==="
    say cli::help(app)

    # 6. Simulate parsing realistic CLI arguments
    say "=== Parsing Simulated Command ==="
    let sample_args = ["build", "-v", "--release", "--target=native", "-o", "bin/release", "server.alya"]
    say "Running with args: build -v --release --target=native -o bin/release server.alya"

    let ctx = app.run(sample_args)
    if ctx.has_errors()
        say "Errors encountered during parsing:"
        for err in ctx.errors()
            say "  * " + str_from_ptr(err)
        end
    else
        say "Command executed : " + ctx.command()
        say "Verbose mode     : " + (ctx.flag("verbose") == 1 ? "yes" : "no")
        say "Release mode     : " + (ctx.flag("release") == 1 ? "yes" : "no")
        say "Target arch      : " + ctx.option("target", "native")
        say "Output path      : " + ctx.option("output", "dist")
        say "Source file      : " + ctx.get_arg_named("entrypoint", "src/main.alya")
    end
end

main()
